# Copy to ~/.config/usefull_scripts/config.env and fill in.

# rec
REC_DIR="$HOME/vids/records"

# archfix
ARCHFIX_PACKAGE_LIST="$HOME/.local/share/usefull_scripts/packages"

# nvidia
NVIDIA_PACKAGES="nvidia-utils nvidia-dkms egl-gbm opencl-nvidia lib32-nvidia-utils nvidia-prime nvidia-settings"
NVIDIA_XORG_CONF="/usr/share/X11/xorg.conf.d/10-nvidia-drm-outputclass.conf"
NVIDIA_XORG_BACKUP="$HOME/.local/share/usefull_scripts/10-nvidia-drm-outputclass.conf.off"

# novpn
NOVPN_USER="bypass_user"
NOVPN_DNS="1.1.1.1"
NOVPN_BROWSER="ungoogled-chromium"

# pcap: name=ssh-target, space separated
PCAP_HOSTS="server=user@198.51.100.10 router=root@192.168.1.1"

# focus
FOCUS_DOMAINS="example.com another.example"
FOCUS_PROGRAMS="Telegram firefox steam"
FOCUS_BLACKLIST="/etc/unbound/blacklist.conf"

# whisper: ggml/ and ct2/ model dirs, and a python with faster-whisper for -c
WHISPER_MODELS_DIR="$HOME/.local/share/whisper"
WHISPER_CT_PYTHON="$HOME/.local/share/venv/bin/python"
