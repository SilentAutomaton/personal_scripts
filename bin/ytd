#!/bin/bash
set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

need_command yt-dlp

AUDIO=0
FRAG=0
WATCH=0
FORMAT=0
OUTPUT=""
START=""
DURATION=""

usage() {
  cat <<'EOF'
Usage: ytd [OPTIONS] [URL]
With no URL the clipboard is used.

Options:
  -a          download the audio as mp3
  -f          download a fragment, needs -s and -d
  -w          watch in mpv
  -F          choose the format with fzf
  -s TIME     fragment start, as 00:01:30
  -d TIME     fragment duration, as 00:02:00
  -o FILE     output filename
  -h          show this message

-a, -f and -w are mutually exclusive.
EOF
}

while getopts "afwFs:d:o:h" opt; do
  case $opt in
    a) AUDIO=1 ;;
    f) FRAG=1 ;;
    w) WATCH=1 ;;
    F) FORMAT=1 ;;
    s) START="$OPTARG" ;;
    d) DURATION="$OPTARG" ;;
    o) OUTPUT="$OPTARG" ;;
    h) usage; exit 0 ;;
    \?) usage >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

[ $((AUDIO + FRAG + WATCH)) -le 1 ] || die "Too many modes. -a, -f and -w cannot be combined. Pick one."

if [ "$FRAG" -eq 1 ] && { [ -z "$START" ] || [ -z "$DURATION" ]; }; then
  die "Incomplete fragment. -f needs both a start and a duration. Add -s and -d."
fi

link="${1:-$(clipboard)}"
[ -n "$link" ] || die "No link. None was given and the clipboard is empty. Pass the URL as an argument."

cookies=()
[ -n "${YTD_COOKIES:-}" ] && [ -r "$YTD_COOKIES" ] && cookies=(--cookies "$YTD_COOKIES")

output_opt=()
[ -n "$OUTPUT" ] && output_opt=(-o "$OUTPUT")

format_opt=()
if [ "$FORMAT" -eq 1 ]; then
  format_id=$(yt-dlp "${cookies[@]}" -F "$link" | pick format | awk '{print $1}')
  [ -n "$format_id" ] || die "No format chosen. Nothing was selected in the list. Run ytd again and pick one."
  format_opt=(-f "$format_id")
fi

if [ "$AUDIO" -eq 1 ]; then
  yt-dlp --extract-audio --audio-format mp3 "${cookies[@]}" \
    --sponsorblock-remove music_offtopic "${output_opt[@]}" "$link"
elif [ "$FRAG" -eq 1 ]; then
  need_command ffmpeg
  mapfile -t urls < <(yt-dlp -f "bestvideo+bestaudio" "${cookies[@]}" -g "$link")
  [ ${#urls[@]} -ge 2 ] || die "Cannot split the streams. The site returned one URL, not a video and an audio one. Download the whole file instead."
  ffmpeg -ss "$START" -i "${urls[0]}" -ss "$START" -i "${urls[1]}" \
    -map 0:v -map 1:a -c:v libx264 -c:a aac -t "$DURATION" "${OUTPUT:-fragment.mp4}"
elif [ "$WATCH" -eq 1 ]; then
  need_command mpv
  mpv "$link"
else
  yt-dlp "${cookies[@]}" "${format_opt[@]}" --sponsorblock-remove sponsor \
    "${output_opt[@]}" "$link"
fi
